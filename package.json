{
  "name": "bb-plugin-triage-sidebar",
  "version": "0.1.0",
  "type": "module",
  "description": "Replaces the BB thread list with a triage inbox: threads needing attention rise to the top, color-coded status, pinning, and auto-archive for settled threads.",
  "license": "MIT",
  "engines": {
    "bb": ">=0.37.0",
    "bbPluginSdk": ">=0.4.3"
  },
  "bb": {
    "name": "Triage Sidebar",
    "description": "Replaces the BB thread list with a triage inbox: threads needing attention rise to the top, color-coded status, pinning, and auto-archive for settled threads.",
    "branding": {
      "icon": "PanelLeft"
    },
    "app": "./app.tsx",
    "server": "./src/server.ts"
  },
  "keywords": [
    "bb-plugin"
  ],
  "scripts": {
    "build": "bb plugin build",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.1.3",
    "@hugeicons/react": "^1.1.6",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.4.4",
    "@radix-ui/react-context-menu": "^2.3.3",
    "@radix-ui/react-select": "^2.3.3",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "bb-app": "0.37.0",
    "better-sqlite3": "12.10.0",
    "cron-parser": "^5.10.0",
    "jsdom": "^29.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^4.1.1"
  }
}
